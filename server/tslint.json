{
  "extends": "tslint:recommended",
  "rulesDirectory": [],
  "parserOptions": {
    "project": [
      "./tsconfig.json"
    ]
  },
  "rules": {
    "max-line-length": {
      "options": [
        80
      ]
    },
    "semicolon": true,
    "comment-format": false,
    "no-angle-bracket-type-assertion": false,
    "new-parens": true,
    "no-arg": true,
    "no-bitwise": true,
    "no-conditional-assignment": true,
    "no-consecutive-blank-lines": false,
    "no-console": {
      "severity": "warning",
      "options": [
        "debug",
        "info",
        "time",
        "timeEnd",
        "trace"
      ]
    },
    "skipBlankLines": false,
    "no-trailing-whitespace": false,
    "no-any": false,
    "no-var-requires": false,
    "quotemark": [
      true,
      "single",
      "jsx-double"
    ]
  },
  "jsRules": {
    "max-line-length": {
      "options": [
        220
      ]
    }
  }
}
