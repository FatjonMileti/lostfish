{
  "name": "lost.fish.api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "cli": "ts-node ./cli.ts",
    "start": "nodemon --inspect ./src/bin/www.ts",
    "dev": "ts-node ./src/bin/www.ts",
    "seed": "ts-node ./src/seeders/index.ts",
    "dev-brk": "nodemon --inspect-brk ./src/bin/www.ts",
    "docs": "npx apidoc -i ./src/api -o ./docs",
    "build": "tsc -p tsconfig.json",
    "start-dist": "node ./dist/bin/www.js",
    "format": "npx prettier -w ./src"
  },
  "nodemonConfig": {
    "events": {
      "start": "npm run docs"
    },
    "ignore": [
      "docs/",
      "node_modules/*",
      "public/",
      "uploads/"
    ],
    "execMap": {
      "ts": "node --require ts-node/register"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.358.0",
    "@aws-sdk/s3-request-presigner": "^3.358.0",
    "@casl/ability": "^6.5.0",
    "@faker-js/faker": "^8.0.2",
    "@socket.io/redis-adapter": "^8.1.0",
    "@types/docusign-esign": "^5.19.1",
    "axios": "^1.3.4",
    "bcrypt": "^5.0.1",
    "body-parser": "^1.19.0",
    "chalk": "^4.1.2",
    "class-validator": "^0.14.0",
    "compression": "^1.7.4",
    "connect-mongo": "^4.6.0",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "csurf": "^1.11.0",
    "debug": "~2.6.9",
    "docusign-esign": "^6.3.0",
    "dotenv": "^10.0.0",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-fileupload": "^1.2.1",
    "express-rate-limit": "^6.9.0",
    "express-session": "^1.17.2",
    "form-data": "^4.0.0",
    "google-auth-library": "^8.8.0",
    "hbs": "^4.1.2",
    "helmet": "^4.6.0",
    "http-errors": "~1.6.3",
    "http-status": "^1.6.2",
    "inquirer": "^8.2.0",
    "ioredis": "^5.3.2",
    "joi": "^17.4.2",
    "joi-extract-type": "^15.0.8",
    "jsonwebtoken": "^9.0.1",
    "lodash.merge": "^4.6.2",
    "moment": "^2.29.1",
    "mongoose": "^7.0.3",
    "mongoose-paginate-v2": "^1.5.0",
    "morgan": "~1.9.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.1",
    "rate-limiter-flexible": "^2.3.2",
    "rotating-file-stream": "^3.1.1",
    "sharp": "^0.32.5",
    "socket.io": "^4.6.1",
    "socket.io-adapter": "^2.5.2",
    "twitter-api-sdk": "^1.2.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/compression": "^1.7.2",
    "@types/cookie-parser": "^1.4.3",
    "@types/csurf": "^1.11.2",
    "@types/express": "^4.17.13",
    "@types/express-fileupload": "^1.2.2",
    "@types/express-session": "^1.17.4",
    "@types/http-errors": "^1.8.1",
    "@types/joi": "^17.2.3",
    "@types/jsonwebtoken": "^8.5.6",
    "@types/lodash.merge": "^4.6.7",
    "@types/mongoose": "^5.11.97",
    "@types/mongoose-paginate-v2": "^1.4.3",
    "@types/morgan": "^1.9.4",
    "@types/multer": "^1.4.7",
    "@types/multer-s3": "^3.0.0",
    "@types/node": "^16.11.1",
    "@types/socket.io": "^3.0.2",
    "apidoc": "^0.50.5",
    "nodemon": "^2.0.14",
    "prettier": "^2.5.0",
    "ts-node": "^10.3.0",
    "tslint": "^6.1.3",
    "typescript": "^4.4.4"
  }
}
